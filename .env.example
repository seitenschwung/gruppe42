# Copy to .env for local tests (never commit .env). In production these are set in Coolify.
# Stripe TEST mode keys only until the shop goes live (sk_test_..., pk_test_..., whsec_...).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_URL=https://gruppe42.seitenschwung.com
# Test editor (/editor): GitHub App "Gruppe 42 Editor", callback URL https://gruppe42.seitenschwung.com/api/editor/callback.
# Without both values the /api/editor/* routes answer 503. The secret also revokes tokens on logout.
EDITOR_GITHUB_CLIENT_ID=
EDITOR_GITHUB_CLIENT_SECRET=
# Live editor (passkey login). Without both values (or without a writable data dir) /api/editor/* answers 503.
# EDITOR_ORIGIN is the bare origin, EDITOR_RP_ID its hostname (or a registrable suffix of it).
# e.g. EDITOR_ORIGIN=https://gruppe42.seitenschwung.com, EDITOR_RP_ID=gruppe42.seitenschwung.com
EDITOR_ORIGIN=
EDITOR_RP_ID=
# EDITOR_DATA_DIR=/data/editor   (invitations, passkeys, overlay; default /data/editor)
# EDITOR_MELDUNG_URL=            (optional, notification after publishing; Task 5)
